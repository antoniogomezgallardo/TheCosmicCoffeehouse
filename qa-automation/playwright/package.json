{
  "name": "@cosmic-coffeehouse/e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End testing suite with Playwright and BDD for The Cosmic Coffeehouse",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:debug": "npx playwright test --debug",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:mobile": "npx playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --grep '@smoke'",
    "test:regression": "npx playwright test --grep '@regression'",
    "test:critical": "npx playwright test --grep '@critical'",
    "report": "npx playwright show-report",
    "install:browsers": "npx playwright install",
    "install:deps": "npx playwright install-deps",
    "codegen": "npx playwright codegen localhost:5174",
    "cucumber": "cucumber-js",
    "cucumber:report": "cucumber-js --format html:reports/cucumber-report.html",
    "lint": "tsc --noEmit",
    "clean": "rimraf test-results reports .playwright",
    "setup": "npm run install:deps && npm run install:browsers"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "automation",
    "bdd",
    "cucumber",
    "typescript",
    "qa"
  ],
  "author": "Antonio Gomez Gallardo",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@cucumber/gherkin": "^35.1.0",
    "@cucumber/pretty-formatter": "^2.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "dotenv": "^17.2.2",
    "playwright": "^1.55.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
