# E2E Testing Environment Configuration

# Application URLs
BASE_URL=http://localhost:5174
API_URL=http://localhost:3001

# Browser Configuration
BROWSER=chromium
HEADED=false
HEADLESS=true
SLOW_MO=0

# Test Execution
FAIL_FAST=false
PARALLEL=2
RETRIES=1

# Debugging
DEBUG=false
TRACE=false

# CI/CD Configuration
CI=false

# Test Data
E2E_USER_EMAIL=e2e.test@cosmicoffeehouse.com
E2E_USER_PASSWORD=TestPassword123!

# Cucumber Configuration
CUCUMBER_TAGS=not @skip

# Timeouts (milliseconds)
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
NAVIGATION_TIMEOUT=10000

# Screenshots and Videos
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_RETRY=true

# Performance Thresholds
PAGE_LOAD_TIMEOUT=5000
API_RESPONSE_TIMEOUT=3000