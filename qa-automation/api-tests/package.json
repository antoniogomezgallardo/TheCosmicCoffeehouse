{
  "name": "@cosmic-coffeehouse/api-tests",
  "version": "1.0.0",
  "description": "API Integration Tests for The Cosmic Coffeehouse",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest --testPathPattern=auth",
    "test:products": "jest --testPathPattern=products",
    "test:cart": "jest --testPathPattern=cart",
    "test:orders": "jest --testPathPattern=orders",
    "test:users": "jest --testPathPattern=users",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests"
  },
  "dependencies": {
    "@types/supertest": "^2.0.16",
    "dotenv": "^16.3.1",
    "mongoose": "^8.18.2",
    "supertest": "^6.3.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest.setup.ts"
    ],
    "testTimeout": 30000,
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "keywords": [
    "api",
    "integration",
    "testing",
    "supertest",
    "jest",
    "typescript"
  ],
  "author": "The Cosmic Coffeehouse QA Team",
  "license": "MIT"
}
