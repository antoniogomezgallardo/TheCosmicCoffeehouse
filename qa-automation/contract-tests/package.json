{
  "name": "@cosmic-coffeehouse/contract-tests",
  "version": "1.0.0",
  "description": "API Contract Testing with Pact for The Cosmic Coffeehouse",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:consumer": "jest --testMatch='**/consumer/**/*.pact.test.ts' --runInBand",
    "test:provider": "jest --testMatch='**/provider/**/*.pact.test.ts' --runInBand",
    "test:contracts": "npm run test:consumer && npm run test:provider",
    "pact:publish": "node scripts/publish-pacts.js",
    "pact:verify": "npm run test:provider",
    "pact:clean": "rimraf pacts/*.json",
    "pact:can-i-deploy": "pact-broker can-i-deploy --pacticipant Frontend --version 1.0.0 --pacticipant Backend --version 1.0.0",
    "coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "contract-testing",
    "pact",
    "api-testing",
    "consumer-driven-contracts",
    "microservices",
    "e-commerce"
  ],
  "author": "The Cosmic Coffeehouse QA Team",
  "license": "MIT",
  "devDependencies": {
    "@pact-foundation/pact": "^13.1.4",
    "@pact-foundation/pact-node": "^10.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "axios": "^1.7.9",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jest-pact": "^0.11.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/consumer/config/jest.setup.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "consumer/**/*.ts",
      "provider/**/*.ts",
      "!**/node_modules/**",
      "!**/config/**",
      "!**/*.d.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/pacts/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}