              "firstName": "John",
              "id": "507f1f77bcf86cd799439011",
              "isActive": true,
              "lastName": "Doe",
              "powerLevel": 0,
              "updatedAt": "2015-08-06T16:53:10.123+01:00",
              "username": "cosmicuser"
            }
          },
          "message": "User registered successfully",
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
