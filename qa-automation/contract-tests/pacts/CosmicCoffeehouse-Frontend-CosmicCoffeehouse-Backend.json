      "response": {
        "body": {
          "error": "VALIDATION_ERROR",
          "errors": [
            {
              "field": "email",
              "message": "Invalid email format"
            }
          ],
          "message": "Validation failed",
          "success": false
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.errors": {
            "match": "type",
            "min": 1
          },
          "$.body.errors[*].field": {
            "match": "type"
          },
          "$.body.errors[*].message": {
            "match": "type"
          },
          "$.body.message": {
            "match": "type"
          }
        },
        "status": 400
