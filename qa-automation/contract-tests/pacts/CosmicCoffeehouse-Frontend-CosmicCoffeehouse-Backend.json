{
  "consumer": {
    "name": "CosmicCoffeehouse-Frontend"
  },
  "interactions": [
    {
      "description": "a login request with invalid credentials",
      "providerState": "a user with valid credentials exists",
      "request": {
        "body": {
          "email": "test@cosmic.com",
          "password": "WrongPassword123!"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/auth/login"
      },
      "response": {
        "body": {
          "error": "UNAUTHORIZED",
          "message": "Invalid credentials",
          "success": false
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.message": {
            "match": "type"
          }
        },
        "status": 401
      }
    },
    {
      "description": "a logout request from authenticated user",
