    {
      "description": "a request for all capsules",
      "providerState": "products exist in the database",
      "request": {
        "method": "GET",
        "path": "/api/products/capsules"
      },
      "response": {
        "body": {
          "data": {
            "capsules": [
              {
                "category": "capsule",
                "createdAt": "2015-08-06T16:53:10.123+01:00",
                "description": "A powerful blend for morning energy",
                "flavorProfile": "Bold and Rich",
                "id": "507f1f77bcf86cd799439011",
                "imageUrl": "https://cosmic.com/images/quantum-roast.jpg",
                "intensity": 8,
                "isActive": true,
                "name": "Quantum Roast",
                "powerBoost": 75,
                "price": 12.99,
                "stock": 100,
                "updatedAt": "2015-08-06T16:53:10.123+01:00"
              }
            ],
            "limit": 10,
            "page": 1,
            "total": 10
          },
          "message": "Capsules retrieved successfully",
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.data.capsules": {
            "match": "type",
            "min": 1
          },
          "$.body.data.capsules[*].category": {
            "match": "type"
          },
          "$.body.data.capsules[*].createdAt": {
            "match": "regex",
            "regex": "^\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d(:?[0-5]\\d)?|Z)$"
          },
          "$.body.data.capsules[*].description": {
            "match": "type"
          },
          "$.body.data.capsules[*].flavorProfile": {
            "match": "type"
          },
          "$.body.data.capsules[*].id": {
            "match": "type"
          },
          "$.body.data.capsules[*].imageUrl": {
            "match": "type"
          },
          "$.body.data.capsules[*].intensity": {
            "match": "type"
          },
          "$.body.data.capsules[*].isActive": {
            "match": "type"
          },
          "$.body.data.capsules[*].name": {
            "match": "type"
          },
          "$.body.data.capsules[*].powerBoost": {
            "match": "type"
          },
          "$.body.data.capsules[*].price": {
            "match": "type"
          },
          "$.body.data.capsules[*].stock": {
            "match": "type"
          },
          "$.body.data.capsules[*].updatedAt": {
            "match": "regex",
            "regex": "^\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d(:?[0-5]\\d)?|Z)$"
          },
          "$.body.data.limit": {
            "match": "type"
          },
          "$.body.data.page": {
            "match": "type"
          },
          "$.body.data.total": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
