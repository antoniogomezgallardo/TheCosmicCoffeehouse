    {
      "description": "a valid registration request",
      "providerState": "user does not exist",
      "request": {
        "body": {
          "email": "test@cosmic.com",
          "firstName": "John",
          "lastName": "Doe",
          "password": "SecurePass123!",
          "username": "cosmicuser"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/auth/register"
      },
      "response": {
        "body": {
          "data": {
            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjUwN2YxZjc3YmNmODZjZDc5OTQzOTAxMSIsImVtYWlsIjoidGVzdEBjb3NtaWMuY29tIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
