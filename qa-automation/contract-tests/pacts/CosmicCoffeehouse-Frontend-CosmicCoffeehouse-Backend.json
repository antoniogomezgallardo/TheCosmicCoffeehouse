        "status": 404
      }
    },
    {
      "description": "a request for out of stock product",
      "providerState": "product is out of stock",
      "request": {
        "method": "GET",
        "path": "/api/products/capsules/507f1f77bcf86cd799439011"
      },
      "response": {
        "body": {
          "data": {
