          "$.body.data.limit": {
            "match": "type"
          },
          "$.body.data.machines": {
            "match": "type",
            "min": 1
          },
          "$.body.data.machines[*].id": {
            "match": "type"
          },
          "$.body.data.machines[*].model": {
            "match": "type"
          },
          "$.body.data.machines[*].name": {
            "match": "type"
          },
          "$.body.data.machines[*].price": {
            "match": "type"
